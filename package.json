{
  "name": "nsw-fuel-finder",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Live NSW fuel prices near you, cheapest first for the fuel you use.",
  "license": "MIT",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:netlify": "netlify dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bundle:check": "node scripts/check-bundle-budget.js",
    "check:browser": "node scripts/smoke-check.mjs",
    "check:a11y": "node scripts/a11y-check.mjs",
    "serve:headers": "node scripts/serve-with-headers.mjs",
    "history:backfill": "node scripts/build-history-backfill.mjs",
    "auth:reset": "node scripts/auth-reset.mjs",
    "qld:switch": "node scripts/qld-switch.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "assets:icons": "node scripts/generate-icons.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@netlify/blobs": "^11.1.4",
    "@tabler/icons-react": "^3.50.0",
    "@tanstack/react-query": "^5.104.5",
    "downshift": "^9.4.0",
    "maplibre-gl": "6.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "0.8.3",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "playwright": "1.63.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings 0 --no-warn-ignored --fix",
      "prettier --write"
    ],
    "*.{js,json,css,md,yml,yaml,html}": [
      "prettier --write"
    ]
  }
}
