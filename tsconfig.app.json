{
  // The browser project: application source and its tests.
  // Deliberately has no Node types, so nothing here can reach for `process`
  // or `fs` and quietly assume a server exists.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",

    // `vite/client` types `*.module.css` imports and `import.meta.env`.
    // `geojson` is the global GeoJSON namespace MapLibre's types are written in.
    "types": ["vite/client", "geojson"],

    // `@/foo` resolves to `src/foo`. Paths without `baseUrl` are resolved
    // relative to this file. Must be kept in sync with the matching
    // `resolve.alias` entry in vite.config.ts - tsc and Vite resolve separately.
    "paths": {
      "@/*": ["./src/*"],
    },

    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
  },
  // `shared/` is the API contract the function and the app both speak. It is
  // types and pure functions only, so it type-checks in both projects.
  "include": ["src", "shared", "vitest.setup.ts"],
}
